#!/bin/bash
#
# create_golden_image.sh
#
# Interactively creates a golden image from an SD card, auto-detects
# Diretta version, and prompts for specific shrinking options.

# --- Configuration ---
set -e          # Exit immediately if a command exits with a non-zero status.
set -o pipefail # Exit if any command in a pipeline fails.

BLOCK_SIZE_DD="4M"
BLOCK_SIZE_BYTES=$((4 * 1024 * 1024)) # 4MiB in bytes

# --- Automatic MMC Device Detection ---
echo "🔎 Searching for microSD card / USB devices..."
mapfile -t mmc_devices < <(lsblk -dnbo PATH,SIZE | awk '$2 > 0 {print $1}' | grep /mmcblk || true)

if [ "${#mmc_devices[@]}" -eq 1 ]; then
  DEVICE="${mmc_devices[0]}"
  echo "✅ Success! Using internal microSD card reader: ${DEVICE}"
elif [ "${#mmc_devices[@]}" -gt 1 ]; then
  echo "🚫 Error: Multiple 'mmc' devices detected. Cannot determine the correct one."
  exit 1
else
  # Exclude root disk, loop devices, zram devices
  ROOT_PART=$(findmnt -n -o SOURCE / | cut -d'[' -f1)
  ROOT_DISK=$(lsblk -no PKNAME "${ROOT_PART}" 2>/dev/null || true)
  if [ -z "${ROOT_DISK}" ]; then
    ROOT_DISK_PATH="${ROOT_PART}"
  else
    ROOT_DISK_PATH="/dev/${ROOT_DISK}"
  fi

  mapfile -t candidate_devices < <(lsblk -dnbo PATH,SIZE | awk '$2 > 0 {print $1}' | grep -v -E "(${ROOT_DISK_PATH}|zram|loop)" || true)

  if [ "${#candidate_devices[@]}" -eq 0 ]; then
    echo "🚫 Error: No microSD card or USB storage device found."
    exit 1
  elif [ "${#candidate_devices[@]}" -eq 1 ]; then
    DEVICE="${candidate_devices[0]}"
    DEV_INFO=$(lsblk -dno SIZE,MODEL "${DEVICE}")
    echo "Found one potential device: ${DEVICE} (${DEV_INFO})"
    read -r -p "Do you want to use this device? (y/N) " -n 1
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Aborting."
      exit 1
    fi
  else
    echo "Multiple potential devices found:"
    select opt in "${candidate_devices[@]}" "Abort"; do
      if [ -n "${opt}" ] && [ "${opt}" != "Abort" ]; then
        DEVICE="${opt}"
        break
      else
        echo "Aborting."
        exit 1
      fi
    done
  fi
fi

# --- Auto-Detect Image Type and Diretta Version ---
echo
echo "🔎 Mounting the device filesystem to detect configuration..."

# Define Partition
if [[ "${DEVICE}" =~ [0-9]$ ]]; then
  ROOT_PART="${DEVICE}p2"
else
  ROOT_PART="${DEVICE}2"
fi

# Create Temp Mount
TMP_MOUNT=$(mktemp -d)

# Make sure we clean up the mount on unexpected exit
cleanup() {
  if mount | grep -q "${TMP_MOUNT}"; then
    sudo umount "${TMP_MOUNT}"
  fi
  if [ -d "${TMP_MOUNT}" ]; then
    rmdir "${TMP_MOUNT}"
  fi
}
trap cleanup EXIT

sudo mount "${ROOT_PART}" "${TMP_MOUNT}"

# 1. Detect image type based on directory presence
if [ -d "${TMP_MOUNT}/opt/diretta-alsa" ]; then
  IMG_TYPE="host"
  echo "   - Auto-detected image type: Host"
elif [ -d "${TMP_MOUNT}/opt/diretta-alsa-target" ]; then
  IMG_TYPE="target"
  echo "   - Auto-detected image type: Target"
else
  echo "   - Neither 'diretta-alsa' nor 'diretta-alsa-target' was found under /opt."
  while true; do
    read -r -p "   - Please enter a name for the image type (alphanumeric only, no spaces): " user_img_type
    if [[ "${user_img_type}" =~ ^[a-zA-Z0-9]+$ ]]; then
      # Convert to lowercase to be consistent
      IMG_TYPE=$(echo "${user_img_type}" | tr '[:upper:]' '[:lower:]')
      break
    else
      echo "     ❌ Invalid name. Please use only alphanumeric characters with no spaces."
    fi
  done
fi

# 2. Detect Diretta package version
if [[ "${IMG_TYPE}" == "host" ]]; then
  PKG_NAME="diretta-alsa-daemon"
elif [[ "${IMG_TYPE}" == "target" ]]; then
  PKG_NAME="diretta-alsa-target"
else
  PKG_NAME=""
fi

DIRETTA_VER=""
if [[ -n "${PKG_NAME}" ]]; then
  # Find the package directory in Pacman DB
  # Arch stores metadata in /var/lib/pacman/local/pkgname-version-rel/
  PKG_DIR=$(find "${TMP_MOUNT}/var/lib/pacman/local" -maxdepth 1 -type d -name "${PKG_NAME}*" | head -n 1)

  if [[ -n "${PKG_DIR}" ]]; then
    # Extract version from the 'desc' file
    # The %VERSION% tag is followed by the version string on the next line
    RAW_VER=$(grep -A 1 "%VERSION%" "${PKG_DIR}/desc" | tail -n 1)

    # Sanitize version string for filename (e.g. 147_12-1 -> _v147_12_1)
    DIRETTA_VER="_v${RAW_VER//-/_}"
    echo "   - Auto-detected ${PKG_NAME} version: ${RAW_VER}"
  else
    echo "   - ⚠️  Could not detect ${PKG_NAME} package version in Pacman DB. Using generic filename."
  fi
else
  echo "   - Custom image type. Skipping Diretta version detection."
fi

# 3. Detect how far this card was built, and whether Roon Bridge is on it
#
# These mirror the check_optional_section() predicates in the QA scripts, which
# are the project's definition of "this appendix has been run". They have to be
# file-based here because the card is mounted, not running, so `pacman -Q` and
# `systemctl is-enabled` are replaced by the on-disk artefacts they report on:
# a package directory under the pacman DB, and a .wants symlink.
#
# The ladder returns the HIGHEST stage that answers yes, because the stages are
# cumulative -- a card through Appendix 9 has also been through 6, 7 and 8, and
# it is the furthest point reached that names the image. Roon Bridge is not a
# stage in that ladder any more: it is content that can sit alongside any of
# them, so it becomes a suffix instead. That is what lets a Roon Host and a
# plain Host, built to the same appendix, coexist rather than one silently
# overwriting the other.
m_has()  { [ -e "${TMP_MOUNT}/$1" ]; }
m_grep() { grep -q "$1" "${TMP_MOUNT}/$2" 2>/dev/null; }
m_pkg()  { compgen -G "${TMP_MOUNT}/var/lib/pacman/local/${1}-[0-9]*" >/dev/null; }
m_unit_enabled() { compgen -G "${TMP_MOUNT}/etc/systemd/system/*.wants/${1}" >/dev/null; }

detect_stage() {
  if [[ "$1" == "host" ]]; then
    m_grep '^FlexCycle=enable' opt/diretta-alsa/setting.inf   && { echo apdx9; return; }
    m_unit_enabled limit-speed-100m.service                   && { echo apdx8; return; }
    m_grep '^CpuSend=[0-9]' opt/diretta-alsa/setting.inf      && { echo apdx7; return; }
    m_grep 'ISOLATED1="2,3"' opt/configuration/isolated.conf  && { echo apdx6; return; }
    m_has home/audiolinux/purist-mode-webui                   && { echo apdx4; return; }
    m_has home/audiolinux/roon-ir-remote                      && { echo apdx2; return; }
    m_pkg argonone-c-git                                      && { echo apdx1; return; }
    # Roon with no appendix at all is the one case where it names the stage.
    m_pkg roonbridge                                          && { echo step9; return; }
  elif [[ "$1" == "target" ]]; then
    m_grep '^ExtEtherMTU=' opt/diretta-alsa-target/diretta_app_target_setting.inf && { echo apdx9; return; }
    m_has etc/diretta-100m                                    && { echo apdx8; return; }
    m_grep 'DEVICES1=.*xhci-hcd' opt/configuration/isolated.conf && { echo apdx7; return; }
    m_grep 'ISOLATED1="2,3"' opt/configuration/isolated.conf  && { echo apdx6; return; }
    m_grep '^purist-app:' etc/passwd                          && { echo apdx4; return; }
    m_has usr/local/bin/purist-mode                           && { echo apdx3; return; }
    m_pkg argonone-c-git                                      && { echo apdx1; return; }
  fi
  echo ""
}

DETECTED_STAGE=$(detect_stage "${IMG_TYPE}")
IMG_ROON=""
if m_pkg roonbridge; then
  IMG_ROON="-roon"
  echo "   - Auto-detected Roon Bridge: present"
else
  echo "   - Auto-detected Roon Bridge: absent"
fi
# Reported for context even though it does not enter the stage-golden filename,
# because it is the one configuration figure that decides what the image can
# play, and it is cheap to read while the card is already mounted.
DETECTED_MTU=$(awk -F= '/^MTUBytes=/ {print $2}' "${TMP_MOUNT}/etc/systemd/network/end0.network" 2>/dev/null)
[ -n "${DETECTED_MTU}" ] && echo "   - Auto-detected link MTU: ${DETECTED_MTU}"

# 4. Clear Web UI session state that must never ship
# set-link-speed.sh advertises 10 Mbps at boot on the mere existence of this
# flag, so a Host captured mid-Super-Purist would hand that link speed to every
# card flashed from the image. prepare_system removes it too; this is the
# backstop for an image taken from a card that was not prepared, and it is the
# last chance to catch it -- once the .img is written the flag is in it.
SP_FLAG="${TMP_MOUNT}/home/audiolinux/purist-mode-webui/super_purist.flag"
if [ -f "${SP_FLAG}" ]; then
  sudo rm -f "${SP_FLAG}"
  echo "   - Removed Super Purist flag from the image."
fi

# Unmount immediately
sudo umount "${TMP_MOUNT}"
rmdir "${TMP_MOUNT}"
trap - EXIT # Clear exit trap

# --- User Interaction ---

# Prompt for the process stage. The detected answer is offered first, because
# picking it by hand is the step that clobbered an image: two Host cards from the
# same build differ only by Roon Bridge, and the menu has no way to say so. The
# menu stays as the override, and is the only path when nothing was detected.
if [ -n "${DETECTED_STAGE}" ]; then
  echo
  echo "   Detected stage: ${DETECTED_STAGE}${IMG_ROON:+  (with Roon Bridge)}"
  read -r -p "   Use the detected stage? (Y/n) " use_detected
  if [[ ! "${use_detected}" =~ ^[Nn] ]]; then
    IMG_STAGE="${DETECTED_STAGE}"
  fi
fi

if [ -z "${IMG_STAGE}" ]; then
echo
echo "Select the process stage:"
options=(
  "Step 9"
  "Appendix 1"
  "Appendix 2"
  "Appendix 3"
  "Appendix 4"
  "Appendix 6"
  "Appendix 7"
  "Appendix 8"
  "Appendix 9"
)
select stage_choice in "${options[@]}"; do
  if [ -n "${stage_choice}" ]; then
    case $stage_choice in
      "Step 9")
        IMG_STAGE="step9"
        break
        ;;
      "Appendix 1")
        IMG_STAGE="apdx1"
        break
        ;;
      "Appendix 2")
        IMG_STAGE="apdx2"
        break
        ;;
      "Appendix 3")
        IMG_STAGE="apdx3"
        break
        ;;
      "Appendix 4")
        IMG_STAGE="apdx4"
        break
        ;;
      "Appendix 6")
        IMG_STAGE="apdx6"
        break
        ;;
      "Appendix 7")
        IMG_STAGE="apdx7"
        break
        ;;
      "Appendix 8")
        IMG_STAGE="apdx8"
        break
        ;;
      "Appendix 9")
        IMG_STAGE="apdx9"
        break
        ;;
      *) echo "Invalid selection. Please try again." ;;
    esac
  else
    echo "Invalid selection. Please try again."
  fi
done
fi

# --- Calculation and Execution ---

# 1. Construct the final filename
# -golden stays the last token of this family, so the Roon marker goes before
# it: diretta-host_v148_5_1-apdx9-roon-golden.img beside the plain one.
FILENAME="diretta-${IMG_TYPE}${DIRETTA_VER}-${IMG_STAGE}${IMG_ROON}-golden.img"

# Refuse to silently overwrite. dd would truncate an existing image without a
# word, and the one it truncates is the finished article waiting to be sent.
if [ -e "${FILENAME}" ]; then
  echo
  echo "⚠️  ${FILENAME} already exists:"
  echo "      $(du -h "${FILENAME}" | cut -f1)  $(date -r "${FILENAME}" '+%Y-%m-%d %H:%M')"
  read -r -p "   Overwrite it? (y/N) " overwrite_ok
  if [[ ! "${overwrite_ok}" =~ ^[Yy] ]]; then
    echo "🚫 Aborted. Nothing was written."
    exit 1
  fi
fi

echo
echo "⚙️  Preparing to create image..."
echo "================================="

# 2. Get partition info using 'parted' for robustness
echo -n "🔎 Reading partition table from ${DEVICE}... "
PART_INFO=$(sudo parted -ms "${DEVICE}" unit B print | grep "^2:")
END_BYTE=$(echo "${PART_INFO}" | cut -d':' -f3 | tr -d 'B')
echo "Done."

if ! [[ "${END_BYTE}" =~ ^[0-9]+$ ]]; then
  echo "🚫 Error: Could not determine the end sector of the partition."
  exit 1
fi

# 3. Calculate the total size and the 'count' for dd
TOTAL_BYTES=$((END_BYTE + 1))
# Use integer arithmetic for ceiling division: ceil(A/B) = (A+B-1)/B
COUNT=$(((TOTAL_BYTES + BLOCK_SIZE_BYTES - 1) / BLOCK_SIZE_BYTES))

# 4. Display parameters and ask for confirmation
echo
echo "Image Parameters:"
echo "---------------------------------"
echo "  Source Device : ${DEVICE}"
echo "  Output File   : ${FILENAME}"
echo "  Total Bytes   : ${TOTAL_BYTES}"
echo "  Block Size    : ${BLOCK_SIZE_DD}"
echo "  DD Count      : ${COUNT}"
echo "---------------------------------"
echo

read -p "Do you want to proceed with these settings? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  echo "Aborting."
  exit 1
fi

# 5. Execute the dd command
echo
echo "🚀 Starting image creation with dd... (This may take a few minutes)"
sudo dd if="${DEVICE}" of="${FILENAME}" bs="${BLOCK_SIZE_DD}" count="${COUNT}" status=progress conv=fsync
sudo chown "${LOGNAME}:${LOGNAME}" "${FILENAME}"

echo
echo "✅ Success! Image created: ${FILENAME}"

# --- NEW: Explicit Shrink Selection ---
echo
echo "Select post-processing operation:"
select shrink_opt in "Shrink (Final - Expands on Boot)" "Shrink-8 (Intermediate - Caps at 8GB)" "Skip"; do
  case $shrink_opt in
    "Shrink (Final - Expands on Boot)")
      echo "Running full shrink..."
      shrink-image "${FILENAME}"
      break
      ;;
    "Shrink-8 (Intermediate - Caps at 8GB)")
      echo "Running shrink-8 (Intermediate)..."
      shrink-image "${FILENAME}" 8
      break
      ;;
    "Skip")
      echo "Skipping shrink process."
      break
      ;;
    *) echo "Invalid option. Please select 1, 2, or 3." ;;
  esac
done

echo "Done."
