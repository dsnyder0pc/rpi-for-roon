#!/bin/bash

# ==============================================================================
#     Remote System Preparation & Shutdown Script (v9 - UTC on shipped images)
#
# Meant to be run with a command that first clears the calling user's history:
# history -c; rm -f ~/.bash_history; export HISTSIZE=0; curl -fsSL https://raw.githubusercontent.com/dsnyder0pc/rpi-for-roon/refs/heads/main/scripts/prepare_system | sudo bash
# ==============================================================================

# --- Configuration ---
TARGET_USER="audiolinux"
MIRRORLIST_PATH="/etc/pacman.d/mirrorlist"
DEFAULT_MIRROR="http://mirror.archlinuxarm.org/\$arch/\$repo"
CUSTOM_MIRROR="http://ca.us.mirror.archlinuxarm.org/\$arch/\$repo"
MOTD_FILE="/etc/motd"
# end0's interrupts on the two boards this project supports: 27 and 28 on a
# Pi 4, 103 on a Pi 5. Written verbatim so a card ships naming both boards
# whichever one it was prepped on.
#
# Maintained by hand. The numbers are assigned by the kernel and have moved
# between releases -- end0 was 104 on one and 103 on the next -- so check them
# after a kernel bump against the office pair, which has one of each board:
#
#   for h in office office-target; do
#     ssh $h 'grep end0 /proc/interrupts | awk "{print \$1}" | tr -d :'
#   done
#
# Being stale costs nothing at runtime. AudioLinux's isolated_app.sh rebuilds
# IRQ1 from DEVICES1 on every boot and pins from what it resolves there, never
# from this file, so this is the value a card ships with and not what pins
# anything. DEVICES1 is the field that has to be right.
END0_IRQS="27 28 103"

# --- Colors ---
RED_BOLD='\033[1;31m'
NC='\033[0m' # No Color

# --- Helper Functions ---
update_config_key() {
    local file="$1"
    local key="$2"
    local value="$3"

    if [ ! -f "$file" ]; then
        echo "   - ⚠️  Warning: Config file '$file' not found."
        return 1
    fi

    if grep -q "^${key}=" "$file"; then
        # Replace existing key
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
        echo "   - Updated ${key} to ${value} in $(basename "$file")"
    else
        # Append key
        echo "${key}=${value}" >> "$file"
        echo "   - Added ${key}=${value} to $(basename "$file")"
    fi
}


update_network_mtu() {
    local mtu="$1"
    local file="/etc/systemd/network/end0.network"

    if [ ! -f "$file" ]; then
        echo "   - ⚠️  Warning: Network file '$file' not found."
        return 1
    fi

    if grep -q "^MTUBytes=" "$file"; then
        # Replace existing MTUBytes
        sed -i "s|^MTUBytes=.*|MTUBytes=${mtu}|" "$file"
        echo "   - Updated MTUBytes to ${mtu} in $(basename "$file")"
    else
        # If [Link] section exists, append under [Link]
        if grep -q -i "^\[Link\]" "$file"; then
            sed -i "/^\[[Ll]ink\]/a MTUBytes=${mtu}" "$file"
            echo "   - Added MTUBytes=${mtu} under [Link] in $(basename "$file")"
        else
            # Append [Link] and MTUBytes to the file
            echo -e "\n[Link]\nMTUBytes=${mtu}" >> "$file"
            echo "   - Appended [Link] and MTUBytes=${mtu} to $(basename "$file")"
        fi
    fi
}


if [[ $EUID -ne 0 ]]; then
   echo "🛑 Error: This script must be run with root privileges."
   exit 1
fi

echo "🚀 Starting remote system preparation..."
echo "------------------------------------------------"

# Step 1: Remove personal SSH public keys
# Both accounts collect them. The build workstation's key lands in the
# audiolinux account, and root picks one up whenever bench work needs
# privileged access -- changing an MTU, say, which cannot be done over sudo
# from a script. Either one would let the builder into every card shipped
# from this image, so both go.
echo "🔐 Removing SSH public keys..."
for keys_file in "/home/$TARGET_USER/.ssh/authorized_keys" "/root/.ssh/authorized_keys"; do
    if [ -f "$keys_file" ]; then
        rm -fv "$keys_file"
    else
        echo "   - No $keys_file found. Skipping."
    fi
done

# Step 2: Restore default pacman mirrorlist
echo "🌐 Restoring default pacman mirrorlist..."
if [ -f "$MIRRORLIST_PATH" ]; then
    sed -i "s|# *Server = ${DEFAULT_MIRROR}|Server = ${DEFAULT_MIRROR}|" "$MIRRORLIST_PATH"
    echo "   - Enabled default Geo-IP mirror."
    sed -i "s|^Server = ${CUSTOM_MIRROR}|# Server = ${CUSTOM_MIRROR}|" "$MIRRORLIST_PATH"
    echo "   - Disabled custom California mirror."
else
    echo "   - ⚠️  Warning: Mirrorlist file not found at '$MIRRORLIST_PATH'."
fi

echo "------------------------------------------------"

# Step 3: Remove Roon Unique Identifiers
echo "🧹 Removing Roon Bridge ID..."
rm -fv /var/roon/RoonBridge/Settings/unique_id
echo "🧹 Removing RAAT Server ID..."
rm -fv /var/roon/RAATServer/Settings/unique_id /var/roon/*/Settings/*.json
echo "🧹 Removing Roon IR Remote Extension Token..."
rm -fv "/home/audiolinux/roon-ir-remote/.roon-token"

echo "------------------------------------------------"

# Step 4: Extract Diretta Target Information
echo "🔗 Extracting Diretta Target Information..."
DIRETTA_APP="/opt/diretta-alsa-target/diretta_app_activate"
if [ -f "$DIRETTA_APP" ]; then
    echo "   - Found Diretta application, generating link..."
    ACTIVATION_URL=$($DIRETTA_APP)
    HASH_ID=$(echo "$ACTIVATION_URL" | sed -n 's/.*hash=\([^&]*\).*/\1/p')

    if [ -n "$HASH_ID" ]; then
        echo ""
        echo "================================================"
        echo -e "${RED_BOLD}   !!! COPY THIS DIRETTA INFORMATION NOW !!!${NC}"
        echo "================================================"
        echo "Purchase Link: $ACTIVATION_URL"
        echo "Hardware ID:   $HASH_ID"
        echo "================================================"
        echo ""
    else
        # An activated Target answers "valid" instead of a purchase link.
        echo ""
        echo "================================================"
        echo -e "${RED_BOLD}   !!! THIS TARGET IS ALREADY LICENSED !!!${NC}"
        echo "================================================"
        echo "Diretta reports: $ACTIVATION_URL"
        echo "There is no purchase link to record."
        echo "================================================"
    fi

    # The license is a small file in the Diretta directory named after the
    # hardware ID. It is keyed to this device, so no other Pi can use it, but
    # a card handed to someone else should be clean of it either way. The
    # same criterion shrink-image applies when it lifts the license out of an
    # image: anything here that is not part of the Diretta application.
    find "$(dirname "$DIRETTA_APP")" -maxdepth 1 -type f ! -name 'diretta*' \
        -printf '🧹 Removing Diretta license file: %f\n' -delete 2>/dev/null
else
    echo "   - Diretta application not found. Skipping."
fi

echo "------------------------------------------------"

# Step 5: Remove AudioLinux Menu Configuration Data
echo "🧹 Resetting AudioLinux Menu Configuration Data..."
tee "/opt/configuration/data" <<EOT> /dev/null
EMAIL=
VERSION=
EOT
chmod 600 "/opt/configuration/data"

echo "------------------------------------------------"

# Step 6: Remove test and QA scripts in /home/audiolinux
echo "🧹 Removing test and QA scripts from /home/$TARGET_USER..."
for test_script in tspc.sh hspc.sh diretta-target-checks.sh diretta-host-checks.sh; do
    script_path="/home/$TARGET_USER/$test_script"
    if [ -f "$script_path" ]; then
        rm -fv "$script_path"
    fi
done

# Clean up any test music files under /home/audiolinux/Music
MUSIC_DIR="/home/$TARGET_USER/Music"
if [ -d "$MUSIC_DIR" ]; then
    echo "🧹 Removing files and subdirectories under $MUSIC_DIR..."
    find "$MUSIC_DIR" -mindepth 1 -delete
fi

echo "------------------------------------------------"

# Step 7: Truncate specific log files under /var/log
echo "🧹 Truncating log files under /var/log..."
for logfile in btmp wtmp argononed.log; do
    logpath="/var/log/$logfile"
    if [ -f "$logpath" ]; then
        truncate -s 0 "$logpath"
        echo "   - Truncated $logpath"
    fi
done

echo "------------------------------------------------"

# Step 8: Ensure cpu script is installed
echo "📥 Checking for cpu script..."
CPU_BIN="/usr/local/bin/cpu"
if [ ! -f "$CPU_BIN" ]; then
    echo "   - Downloading and installing cpu script..."
    if curl -fsSL "https://raw.githubusercontent.com/dsnyder0pc/rpi-for-roon/refs/heads/main/scripts/cpu" -o "$CPU_BIN"; then
        chmod 0555 "$CPU_BIN"
        echo "   - Successfully installed to $CPU_BIN with permissions 0555."
    else
        echo "   - ⚠️  Error: Failed to download cpu script."
    fi
else
    echo "   - cpu script already present at $CPU_BIN."
fi

echo "------------------------------------------------"

# Step 9: Apply network and MTU configurations (Target vs Host)
echo "⚙️  Applying network and MTU configurations..."

# Target-specific configurations
if [ -d "/opt/diretta-alsa-target" ]; then
    echo "   - Target system detected."
    TARGET_CONF="/opt/diretta-alsa-target/diretta_app_target_setting.inf"
    if [ -f "$TARGET_CONF" ]; then
        # Full Jumbo (Appendix 9). The 3824 tier existed because that was the
        # largest MTU a Raspberry Pi 4's bcmgenet driver could receive -- its
        # 3840-byte RX buffer less the 2-byte pad and the 14-byte Ethernet
        # header. The realtime LTS kernel these images ship carries the patch
        # that gives the same hardware the full 9000, so both boards reach it
        # and there is no reason to hand a customer the smaller tier.
        # ExtEtherMTU is the same figure plus that header.
        update_config_key "$TARGET_CONF" "ExtEtherMTU" "9014"
        update_config_key "$TARGET_CONF" "EtherMTU" "9000"
        update_config_key "$TARGET_CONF" "TrgetName" "AnCaolas Link"
        update_config_key "$TARGET_CONF" "VolumeCtl" "disable"
        update_config_key "$TARGET_CONF" "AlsaLatency" "30"
        update_config_key "$TARGET_CONF" "DSDNativ" "enable"
        update_config_key "$TARGET_CONF" "DSD48" "disable"
    else
        echo "   - ⚠️  Warning: Target config file not found at $TARGET_CONF"
    fi
    update_network_mtu "9000"

    ISO_CONF="/opt/configuration/isolated.conf"
    if [ -f "$ISO_CONF" ]; then
        # Both USB 2.0 ports are listed because a customer may connect their
        # DAC to either one. DEVICES1 is the real input: AudioLinux's
        # isolated_app.sh resolves these names against /proc/interrupts at
        # every boot and rewrites IRQ1 from what it finds.
        ISO_DEVICES="end0 xhci-hcd:usb1 xhci-hcd:usb3"
        update_config_key "$ISO_CONF" "DEVICES1" "\"${ISO_DEVICES}\""
        update_config_key "$ISO_CONF" "IRQ1" "\"${END0_IRQS}\""
    else
        echo "   - ⚠️  Warning: Isolated config file not found at $ISO_CONF"
    fi
fi

# Host-specific configurations
if [ -d "/opt/diretta-alsa" ]; then
    echo "   - Host system detected."
    HOST_CONF="/opt/diretta-alsa/setting.inf"
    if [ -f "$HOST_CONF" ]; then
        # CycleTime only reaches the wire when the Host uses its own profile.
        # AudioLinux ships TargetProfileLimitTime=200, and at any non-zero
        # value Diretta's automatic target profile elects the cycle instead,
        # silently ignoring the values below.
        update_config_key "$HOST_CONF" "TargetProfileLimitTime" "0"
        update_config_key "$HOST_CONF" "FlexCycle" "enable"
        update_config_key "$HOST_CONF" "InfoCycle" "150000"
        update_config_key "$HOST_CONF" "CycleTime" "1500"
    else
        echo "   - ⚠️  Warning: Host config file not found at $HOST_CONF"
    fi
    update_network_mtu "9000"

    ISO_CONF="/opt/configuration/isolated.conf"
    if [ -f "$ISO_CONF" ]; then
        # DEVICES1 is left as the AudioLinux menu wrote it when core isolation
        # was applied; a Host has no DAC, so there is no xhci bus to add.
        update_config_key "$ISO_CONF" "IRQ1" "\"${END0_IRQS}\""
    else
        echo "   - ⚠️  Warning: Isolated config file not found at $ISO_CONF"
    fi
fi

echo "------------------------------------------------"

# Step 10: Clean up root's Bash history
echo "🧹 Cleaning up root user's Bash history..."
history -c
if [ -f "$HOME/.bash_history" ]; then
    cat /dev/null > "$HOME/.bash_history"
    echo "   - Cleared history file for user 'root'."
fi
export HISTSIZE=0
echo "   - History disabled for this session."

echo "------------------------------------------------"

# Step 11: Clean up audiolinux user's Bash history
echo "🧹 Cleaning up audiolinux user's Bash history..."
USER_HISTORY="/home/$TARGET_USER/.bash_history"
if [ -f "$USER_HISTORY" ]; then
    cat /dev/null > "$USER_HISTORY"
    echo "   - Cleared history file for user '$TARGET_USER'."
fi

echo "------------------------------------------------"

# Step 12: Reclaim Disk Space
echo "🧹 Reclaiming disk space..."
if [ -d "/home/$TARGET_USER/.pyenv" ]; then
    echo "   - Removing Python build artifacts..."
    rm -rf /home/$TARGET_USER/.pyenv/sources/* 2>/dev/null
    sudo -u $TARGET_USER /home/$TARGET_USER/.pyenv/shims/pip cache purge &>/dev/null
fi

echo "   - Clearing Pacman cache and metadata..."
pacman -Scc --noconfirm &>/dev/null

echo "------------------------------------------------"

# Step 13: Clean up audiolinux user's wget logs
echo "🧹 Cleaning up audiolinux user's wget logs..."
WGET_LOG_FILES=(/home/"$TARGET_USER"/wget-log*)
if [ -e "${WGET_LOG_FILES[0]}" ]; then
    rm -fv "${WGET_LOG_FILES[@]}"
    echo "   - Removed wget-log files."
else
    echo "   - No wget-log files found. Skipping."
fi

echo "------------------------------------------------"

# Step 14: Clean up the MOTD
echo "🧹 Cleaning up $MOTD_FILE..."
if [ -f "$MOTD_FILE" ]; then
    # Drop every "Your IP ..." line left behind by update_motd.sh. There can
    # be more than one (the stock AudioLinux version appends a separate
    # "Your IP V6 address is" line), and one may carry no address at all.
    # Then trim trailing blank lines so the banner is followed by exactly one.
    MOTD_TMP=$(mktemp)
    awk '!/^Your IP/ {
             lines[++n] = $0
             if ($0 ~ /[^[:space:]]/) last = n
         }
         END {
             for (i = 1; i <= last; i++) print lines[i]
             print ""
         }' "$MOTD_FILE" > "$MOTD_TMP"
    cat "$MOTD_TMP" > "$MOTD_FILE"
    rm -f "$MOTD_TMP"
    echo "   - Removed IP address lines and normalized trailing blank line."
else
    echo "   - No MOTD file found at '$MOTD_FILE'. Skipping."
fi

echo "------------------------------------------------"

# Step 15: Ship the image on UTC rather than the builder's own timezone
echo "🕒 Setting the system timezone to UTC..."
# These images go to people in timezones the builder does not share, so the
# builder's local zone is not a sensible default for any of them. UTC is the
# neutral choice, and it also makes a log someone sends for help mean the same
# thing to both ends of the conversation. Anyone who wants local time can set
# it themselves; nothing in the build depends on the zone.
if timedatectl set-timezone UTC 2>/dev/null; then
    echo "   - Timezone set to UTC."
else
    # timedatectl needs a running systemd to talk to. The symlink it would have
    # written is the whole of the setting, so write it directly if it cannot.
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime
    echo "   - Timezone set to UTC by symlink (timedatectl unavailable)."
fi

echo "------------------------------------------------"

# Step 16: Drop the machine ID so every install generates its own
echo "🧹 Removing /etc/machine-id..."
# AudioLinux images ship with one already in place, so two systems restored
# from the same image present the same DHCP identifier and a DHCP server hands
# them both the same address. systemd writes a fresh one at the next boot, and
# /var/lib/dbus/machine-id is a symlink to this file, so one truncation covers
# both. shrink-image does the same to the mounted image; doing it here keeps a
# card that is handed to someone else clean on its own.
#
# Emptied rather than removed, which is not the same thing to systemd.
# ConditionFirstBoot is met when the file is missing or reads "uninitialized",
# and a first boot applies preset policy to populate what systemd takes to be
# an unconfigured /etc -- 90-systemd.preset carries
# "enable systemd-networkd-wait-online.service", so removing the file undoes
# Section 7 on the next boot and every boot after. An empty file is populated
# just the same, with a fresh unique ID, and no first boot is declared: verified
# on a prepped pair, which came back with different IDs and no "Detected first
# boot" in the journal. shrink-image has always emptied rather than removed,
# which is why images built through it were never affected.
: > /etc/machine-id
echo "   - Emptied /etc/machine-id (a fresh ID is written at the next boot)"

echo "------------------------------------------------"

# Step 17: Sync disks and power off the system
echo "✅ Preparation complete. System will power off in 5 seconds."
sleep 5
sync
echo "🔌 Powering off now. Goodbye!"
poweroff
